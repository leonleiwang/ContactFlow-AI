# 展示说明：ContactFlow AI 本地环境模板。复制为 .env 后填入真实密钥；不要提交 .env。

MYSQL_DATABASE=contactflow
MYSQL_USER=contactflow
MYSQL_PASSWORD=contactflow
MYSQL_ROOT_PASSWORD=contactflow_root
MYSQL_PORT=3306

BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=contactflow
RABBITMQ_DEFAULT_PASS=contactflow
CONTACTFLOW_RABBIT_ENABLED=true
CONTACTFLOW_REDIS_ENABLED=true

# V0.3 AI Provider 开关：默认关闭真实模型，演示时即使无网络或无 Key 也能走模板/Mock 降级。
LLM_ENABLED=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
LLM_FALLBACK_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_API_KEY=
DASHSCOPE_API_KEY=

RERANK_ENABLED=false
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_SECONDS=3
RERANK_API_KEY=
