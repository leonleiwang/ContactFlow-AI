# ContactFlow AI local environment template.
# Copy to .env for local Docker Compose overrides. Never commit .env.

MYSQL_DATABASE=contactflow
MYSQL_USER=contactflow
MYSQL_PASSWORD=contactflow
MYSQL_ROOT_PASSWORD=contactflow_root
MYSQL_PORT=3306

BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=contactflow
RABBITMQ_DEFAULT_PASS=contactflow

# V0.2 placeholders. Keep empty until real providers are wired.
OPENAI_API_KEY=
EMBEDDING_MODEL=
RERANK_MODEL=
